{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "AI.Sentinel.AspNetCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "AiSentinel": {
    "Enabled": true,
    "ServiceUrl": "http://127.0.0.1:8080",
    "ApiKey": "change-me",
    "RequireHttps": false,
    "EvaluationPath": "/ai-sentinel/v1/evaluation",
    "ConnectTimeoutMilliseconds": 500,
    "ReadTimeoutMilliseconds": 2000,
    "IdentityClaimType": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier",
    "DenyStatusCode": 429,
    "DenyResponseBody": "{\"error\":\"request_denied\"}",
    "IncludeSafeHeaders": true
  }
}
